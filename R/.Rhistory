fuzzy <- function(dep){
file <- paste0("../public/data/",dep,".csv")
df <- read.csv(file)
set.seed(123)
df$latitude <- round(jitter(df$latitude, amount = 0.01), 2)
df$longitude <- round(jitter(df$longitude, amount = 0.01), 2)
return (df)
}
x <- fuzzy("01")
x
fuzzy <- function(dep){
file <- paste0("../public/data/",dep,".csv")
write.csv(file, paste0("../public/data/old/",dep,"_old.csv"), row.names = FALSE)
df <- read.csv(file)
set.seed(123)
df$latitude <- round(jitter(df$latitude, amount = 0.01), 2)
df$longitude <- round(jitter(df$longitude, amount = 0.01), 2)
return (df)
}
